<section class="flex items-center justify-center">
  <div class="py-10 mx-auto max-w-7xl">
    <div class="max-w-xl mx-auto">
      <div class="text-center">
        <div class="relative flex flex-col items-center">
          <%= render 'shared/logo', width: '160', height: '106' %>
          <h1 class="text-6xl font-bold mt-4 mb-4">
            <span style="color: #D04A0A">STR</span>Seal
          </h1>
          <%= render 'shared/strinteg_wordmark', class: 'h-6' %>
        </div>
        <h2 class="mt-6 mb-16 text-lg text-center text-gray-600">
          Sign and seal engineering documents online.
        </h2>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-12 md:gap-10 md:grid-cols-3">
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 bg-base-content rounded-full">
              <%= svg_icon('writing_sign', class: 'w-10 h-10 text-base-100 stroke-1') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold">Professional Seals</h3>
            <p class="text-base text-gray-500">
              Place your state PE seals at their true printed size, alongside signatures and dates.
            </p>
          </div>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 bg-base-content rounded-full">
              <%= svg_icon('devices', class: 'w-10 h-10 text-base-100') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold">Any Device</h3>
            <p class="text-base text-gray-500">
              Review and sign documents from a desktop, tablet or phone.
            </p>
          </div>
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="text-center transition-all">
            <div class="inline-block p-4 mb-4 -mt-16 bg-base-content rounded-full">
              <%= svg_icon('shield_check', class: 'w-10 h-10 text-base-100') %>
            </div>
            <h3 class="mb-4 text-2xl font-semibold">Audit Trail</h3>
            <p class="text-base text-gray-500">
              Every signed document carries a full audit trail and a verifiable digital signature.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%= render 'shared/attribution', with_counter: true %>
