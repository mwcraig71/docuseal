<div class="text-center px-2">
  <% if local_assigns[:with_counter] %>
    <% count = CompletedSubmitter.distinct.count(:submission_id) %>
    <% if count > 1 %>
      <%= t('count_documents_signed_with_html', count:) %>
    <% end %>
  <% end %>
  <a href="<%= Docuseal::PRODUCT_URL %>" target="_blank" rel="noopener noreferrer" class="underline"><%= Docuseal.product_name %></a> by <%= Docuseal::COMPANY_NAME %>
  &middot;
  <%= t('powered_by') %> <a href="<%= Docuseal::UPSTREAM_URL %>" target="_blank" rel="noopener noreferrer" class="underline"><%= Docuseal::UPSTREAM_NAME %></a> - <%= t('open_source_documents_software') %>
</div>
